{
  "id": "mcp-time",
  "name": "Time (official reference server)",
  "kind": "mcp",
  "summary": "Current time and timezone conversions. Tiny, safe, and surprisingly often the thing a model gets wrong without it.",
  "source_name": "Model Context Protocol",
  "source_url": "https://github.com/modelcontextprotocol/servers",
  "license": "MIT",
  "clients": [
    "Claude",
    "Cursor",
    "VS Code",
    "most MCP clients"
  ],
  "risks": [
    "none"
  ],
  "starter": false,
  "verified": "2026-11-10",
  "install": "uvx mcp-server-time",
  "config": "{\n  \"mcpServers\": {\n    \"time\": {\n      \"command\": \"uvx\",\n      \"args\": [\"mcp-server-time\"]\n    }\n  }\n}"
}
