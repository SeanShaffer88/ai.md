  "verified": "2026-11-10",
  "install": "npx -y @modelcontextprotocol/server-memory",
  "config": "{\n  \"mcpServers\": {\n    \"memory\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"@modelcontextprotocol/server-memory\"]\n    }\n  }\n}"
}
