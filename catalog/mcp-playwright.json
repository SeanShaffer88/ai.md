{
  "id": "mcp-playwright",
  "name": "Playwright MCP",
  "kind": "mcp",
  "summary": "Microsoft's browser automation server. Drives a real browser through readable page snapshots instead of screenshots.",
  "source_name": "Microsoft",
  "source_url": "https://github.com/microsoft/playwright-mcp",
  "license": "Apache-2.0",
  "clients": [
    "Claude",
    "VS Code",
    "Cursor",
    "most MCP clients"
  ],
  "risks": [
    "commands",
    "network"
  ],
  "starter": true,
  "verified": "2026-11-10",
  "install": "npx -y @playwright/mcp@latest",
  "config": "{\n  \"mcpServers\": {\n    \"playwright\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"@playwright/mcp@latest\"]\n    }\n  }\n}"
}
