{
  "id": "mcp-fetch",
  "name": "Fetch (official reference server)",
  "kind": "mcp",
  "summary": "Fetches a web page and hands it to the AI as Markdown. Simple, single-purpose, easy to reason about.",
  "source_name": "Model Context Protocol",
  "source_url": "https://github.com/modelcontextprotocol/servers",
  "license": "MIT",
  "clients": [
    "Claude",
    "Cursor",
    "VS Code",
    "most MCP clients"
  ],
  "risks": [
    "network"
  ],
  "starter": true,
  "verified": "2026-11-10",
  "install": "uvx mcp-server-fetch",
  "config": "{\n  \"mcpServers\": {\n    \"fetch\": {\n      \"command\": \"uvx\",\n      \"args\": [\"mcp-server-fetch\"]\n    }\n  }\n}"
}
