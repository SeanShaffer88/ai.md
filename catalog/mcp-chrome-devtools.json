{
  "id": "mcp-chrome-devtools",
  "name": "Chrome DevTools MCP",
  "kind": "mcp",
  "summary": "Official DevTools server for debugging pages, performance traces and network inspection with your AI client.",
  "source_name": "Chrome DevTools team",
  "source_url": "https://github.com/ChromeDevTools/chrome-devtools-mcp",
  "license": "Apache-2.0",
  "clients": [
    "Claude",
    "VS Code",
    "Cursor",
    "most MCP clients"
  ],
  "risks": [
    "commands",
    "network"
  ],
  "starter": false,
  "verified": "2026-11-10",
  "install": "npx -y chrome-devtools-mcp@latest",
  "config": "{\n  \"mcpServers\": {\n    \"chrome-devtools\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"chrome-devtools-mcp@latest\"]\n    }\n  }\n}"
}
